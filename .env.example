# Required. The server refuses to start without these.
ADMIN_USER=change-me
ADMIN_PASSWORD=change-me-at-least-12-chars

# Optional
PORT=5000
NODE_ENV=production
SESSION_TTL_MS=28800000

# Server-side inbox notification. Without it, submissions are stored but not emailed.
WEB3FORMS_ACCESS_KEY=

# Recommended anti-bot verification for all public forms. Create a free
# Cloudflare Turnstile widget and put its secret here. When set, the backend
# rejects any form without a valid server-verified challenge token.
TURNSTILE_SECRET_KEY=
